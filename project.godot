; Fichier de configuration du moteur Godot.

config_version=5

[application]

config/name="Salon des Jeux VR"
config/description="Jeux de société en réalité virtuelle pour Meta Quest 3."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icone.svg"
boot_splash/bg_color=Color(0.03, 0.02, 0.02, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[physics]

common/physics_ticks_per_second=72

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=2048

[xr]

openxr/enabled=true
openxr/reference_space=2
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_interaction_profile=true
openxr/extensions/render_model=true
shaders/enabled=true
